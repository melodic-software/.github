# Owned by this repository. Git has no include mechanism, so there is no shared
# .gitignore to inherit from; each repo maintains its own. Sections below cover
# OS/editor noise plus tooling that may run against this checkout locally, even
# where this repo carries no such source of its own.

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vs/
.vscode/*
!.vscode/extensions.json

# Claude Code worktrees (per-checkout; PR worktree workflow)
.claude/worktrees/

# Per-operator overlays, never committed: .claude/settings.local.json (per-machine
# plugin enablement written by .claude/cloud-bootstrap.sh) and the layered-config
# overlays beside tracked team layers. The .claude/ glob is the form the
# source-control plugin prescribes; the work-items tracker overlay sits at the
# repo root, so it needs its own line.
.claude/*.local.*
.work-item-tracker.local.json

# Exception: .claude/cloud-bootstrap.local.sh is a team-shared extension point
# that .claude/cloud-bootstrap.sh invokes, not a per-operator overlay.
!.claude/cloud-bootstrap.local.sh

# Claude Code observability telemetry (per-checkout JSONL)
.claude/observability/

# Node
node_modules/

# Lefthook: per-developer override config and local-only scripts dir
lefthook-local.yml
.lefthook-local/

# .NET build output
bin/
obj/
