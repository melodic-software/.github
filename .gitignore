# Owned by this repository. Git has no include mechanism, so there is no shared
# .gitignore to inherit from — each repo maintains its own. Sections below cover
# OS/editor noise plus tooling that may run against this checkout locally, even
# where this repo carries no such source of its own.

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vs/
.vscode/*
!.vscode/extensions.json

# Claude Code worktrees (per-checkout; PR worktree workflow)
.claude/worktrees/

# Claude Code local settings — the cloud bootstrap script (.claude/cloud-bootstrap.sh)
# installs plugins at local scope, so this file carries per-machine plugin enablement. Claude Code also
# ignores it globally, but that is a user-level file this repo cannot assume.
.claude/settings.local.json

# Layered-config personal overlays. The source-control and work-items plugins each
# resolve an optional per-operator overlay beside their tracked team layer
# (.claude/source-control.md and .work-item-tracker.json respectively). Both are
# per-machine deviations from team policy and are never committed.
.claude/source-control.local.md
.work-item-tracker.local.json

# Node
node_modules/

# Lefthook — per-developer override config and local-only scripts dir
lefthook-local.yml
.lefthook-local/

# .NET — build output
bin/
obj/
